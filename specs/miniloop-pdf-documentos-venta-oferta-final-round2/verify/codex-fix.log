   210	def _draw_rows(pdf: Any, y: float, items: Iterable[dict], price_label: str, amount_label: str) -> float:
   211	    """Mantiene juntas las filas que caben en una página y repite la cabecera en cada continuación."""
   212	    line_height = 5.0
   213	    page_capacity = int((PAGE_BOTTOM - MARGIN - TABLE_HEADER_HEIGHT) // line_height)
   214	    for item in items:
   215	        description = _safe_pdf_text(str(item.get("description") or ""))
   216	        unit = _safe_pdf_text(str(item.get("unit_of_measure") or ""))
   217	        quantity = format_quantity(item.get("quantity"))
   218	        pdf.set_font("Helvetica", "", 8)
   219	        quantity_size = 8.0
   220	        while pdf.get_string_width(quantity) > 18.0 and quantity_size > 5.0:
   221	            quantity_size -= 0.5
   222	            pdf.set_font("Helvetica", "", quantity_size)
   223	
   224	        cells = (
   225	            (description, 78.0, "L", 8.0),
   226	            (unit, 20.0, "C", 8.0),
   227	            (quantity, 20.0, "C", quantity_size),
   228	            (format_amount(item.get("unit_price")), 30.0, "R", 8.0),
   229	            (format_amount(item.get("line_total")), 32.0, "R", 8.0),
   230	        )
   231	        wrapped_cells = []
   232	        for text, width, align, size in cells:
   233	            pdf.set_font("Helvetica", "", size)
   234	            lines = pdf.multi_cell(width, line_height, text, dry_run=True, output="LINES")
   235	            wrapped_cells.append((lines, width, align, size))
   236	
   237	        line_count = max(1, max(len(lines) for lines, _, _, _ in wrapped_cells))
   238	        if y + min(line_count, page_capacity) * line_height > PAGE_BOTTOM:
   239	            pdf.add_page()
   240	            y = _draw_table_header(pdf, MARGIN, price_label, amount_label)
   241	
   242	        for start in range(0, line_count, page_capacity):
   243	            if start:
   244	                pdf.add_page()
   245	                y = _draw_table_header(pdf, MARGIN, price_label, amount_label)
   246	            stop = min(start + page_capacity, line_count)
   247	            x = MARGIN
   248	            for lines, width, align, size in wrapped_cells:
   249	                pdf.set_font("Helvetica", "", size)
   250	                for index, line in enumerate(lines[start:stop]):
   251	                    pdf.set_xy(x, y + index * line_height)
   252	                    pdf.cell(width, line_height, line, align=align)
   253	                x += width
   254	            y += (stop - start) * line_height
   255	    return y
