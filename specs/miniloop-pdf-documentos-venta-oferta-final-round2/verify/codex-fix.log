    44	def _fit_text(pdf: Any, text: str, width: float, style: str = "B", start: float = 9.0, minimum: float = 6.0) -> str:
    45	    """Fija la fuente en el mayor tamaño (de `start` a `minimum`, pasos de 0,5 pt) en que `text` cabe en
    46	    `width` mm (c_margin de 1 mm por lado). Si ni a `minimum` cabe, corta el texto y añade "..."."""
