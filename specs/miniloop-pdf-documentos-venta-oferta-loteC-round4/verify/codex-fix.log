    svc = SalesDocumentService(db, bid)
    doc = svc.get(doc_id)
    if doc is None:
        raise HTTPException(status_code=404, detail="Documento no encontrado")
    if int(getattr(doc, "business_id", 0) or 0) != int(bid):
        raise HTTPException(status_code=404, detail="Documento no encontrado")

    form = await request.form()
    client_name = (form.get("client_name") or "").strip()
    client_id = (form.get("client_id") or "").strip()
    client_address = (form.get("client_address") or "").strip() or None
    notes = (form.get("notes") or "").strip() or None

    if not client_name:
        raise HTTPException(status_code=422, detail="client_name is required")
    if not client_id:
        raise HTTPException(status_code=422, detail="client_id is required")

    new_valid_until = None
    if (doc.doc_type or "").strip().upper() == "P":
        raw_valid_until = form.get("valid_until")
        try:
            if raw_valid_until is not None and not isinstance(raw_valid_until, str):
                raise ValueError("El vencimiento debe ser texto")
            new_valid_until = resolve_valid_until(
                raw_valid_until,
                doc_type="P",
                issue_date=doc.issue_date,
                validity_days=int(config.sales_documents.quote_validity_days),
                on_empty="keep",
                current=doc.valid_until,
            )
        except ValueError:
            _log.info("valid_until rechazado: %r", raw_valid_until)
            return templates.TemplateResponse(
                request=request,
                name="features/sales_documents/_valid_until_error.html",
                context={},
                status_code=422,
                headers={
                    "HX-Retarget": "#sales-doc-edit-valid-until-error",
                    "HX-Reswap": "innerHTML",
                    "X-Modal-Keep": "1",
                },
            )

    customer = _upsert_customer(db, client_id=client_id, name=client_name, address=client_address, business_id=bid)
    doc.customer_id = customer.id

    items = svc.get_items_ordered(doc.id)

    subtotal = 0.0
    next_line = 1
    for it in items:
        del_flag = form.get(f"del_{it.id}")
        if del_flag:
            SalesDocumentService(db, bid).delete_item(it)
            continue

        desc = (form.get(f"desc_{it.id}") or it.description or "").strip() or "(sin descripción)"
        try:
            qty = float(form.get(f"qty_{it.id}") or 0)
        except Exception:
            _log.debug("sales doc line qty parse fallback: %r", form.get(f"qty_{it.id}"))
            qty = 0.0
        try:
            price = float(form.get(f"price_{it.id}") or 0)
        except Exception:
            _log.debug("sales doc line price parse fallback: %r", form.get(f"price_{it.id}"))
            price = 0.0

        it.line_no = next_line
        next_line += 1
        it.description = desc
        it.quantity = float(qty)
        it.unit_price = float(price)
        it.line_total = float(qty * price)
        subtotal += float(it.line_total or 0)

    new_desc = (form.get("new_desc") or "").strip()
    try:
        new_qty = float(form.get("new_qty") or 0)
    except Exception:
        _log.debug("sales doc new_qty parse fallback: %r", form.get("new_qty"))
        new_qty = 0.0
    try:
        new_price = float(form.get("new_price") or 0)
    except Exception:
        _log.debug("sales doc new_price parse fallback: %r", form.get("new_price"))
        new_price = 0.0

    if new_desc and new_qty > 0:
        new_line_total = float(new_qty * new_price)
        svc = SalesDocumentService(db, bid)
        svc.add_item(
            SalesDocumentItem(
                document_id=doc.id,
                line_no=next_line,
                sku=None,
                description=new_desc,
                unit_of_measure=None,
                quantity=float(new_qty),
                unit_price=float(new_price),
                line_total=new_line_total,
            )
        )
        subtotal += new_line_total

    doc.client_name = client_name
    doc.client_id = client_id
    doc.client_address = client_address
    row_numbers = [int(number) for text in page_texts for number in re.findall(r"Artículo (\d+)\b", text)]
    assert row_numbers == list(range(1, 61))
