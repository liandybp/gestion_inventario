@router.post("/sales-doc/issue", response_class=HTMLResponse)
def sales_doc_issue(
    request: Request,
    doc_type: str = Form(""),
    location_code: str = Form(""),
    client_name: str = Form(""),
    client_id: str = Form(""),
    client_address: str = Form(""),
    notes: str = Form(""),
    currency_code: str = Form(""),
    valid_until: str = Form(""),
    db: Session = Depends(session_dep),
) -> HTMLResponse:
    ctx = ui_context(request, db)
    _ = ctx.user
    bid = ctx.business_id
    config = ctx.config

    doc_type_norm = (doc_type or config.sales_documents.default_type or "F").strip().upper()
    if doc_type_norm not in ("F", "P"):
        doc_type_norm = "F"

    default_doc_location_code = config.locations.default_sale_code()
    selected_location_code = (location_code or "").strip() or default_doc_location_code
    selected_currency_code, selected_currency_symbol = _resolve_currency(config, currency_code)

    client_name = (client_name or "").strip()
    client_id = (client_id or "").strip()
    client_address = (client_address or "").strip() or None
    notes = (notes or "").strip() or None

    if not client_name:
        raise HTTPException(status_code=422, detail="client_name is required")
    if not client_id:
        raise HTTPException(status_code=422, detail="client_id is required")

    now = datetime.now(timezone.utc)
    try:
        valid_until_date = resolve_valid_until(
            valid_until,
            doc_type=doc_type_norm,
            issue_date=now,
            validity_days=int(config.sales_documents.quote_validity_days),
        )
    except ValueError:
        _log.info("valid_until rechazado: %r", valid_until)
        _set_draft(
            request,
            doc_type=doc_type_norm,
            location_code=selected_location_code,
            currency_code=selected_currency_code,
            currency_symbol=selected_currency_symbol,
            client_name=client_name,
            client_id=client_id,
            client_address=client_address,
            notes=notes,
            valid_until=valid_until,
        )
        return _valid_until_error_response(request, db=db, bid=bid, config=config)

    customer = _upsert_customer(db, client_id=client_id, name=client_name, address=client_address, business_id=bid)

    cart = _get_cart(request)
    if not cart:
        raise HTTPException(status_code=422, detail="El carrito está vacío")

    year_month = now.strftime("%Y%m")
    yyyymmdd = now.strftime("%Y%m%d")

    max_seq = SalesDocumentService(db, bid).max_seq(year_month)
    seq = int(max_seq or 0) + 1
    code = f"{doc_type_norm}{yyyymmdd}{seq:04d}"

    loc_id = _location_id_for_code(db, location_code=selected_location_code, business_id=bid)
    if loc_id is None:
        raise HTTPException(status_code=409, detail=f"Unknown location_code: {selected_location_code}")

    issuer_address_parts = [
        config.issuer.address,
        " ".join([p for p in [config.issuer.postal_code, config.issuer.city] if p]),
        config.issuer.country,
    ]
    issuer_address = ", ".join([p for p in issuer_address_parts if (p or "").strip()]) or None

    items: list[SalesDocumentItem] = []
    subtotal = 0.0
    for i, it in enumerate(cart, start=1):
        desc = str(it.get("description") or "").strip() or "(sin descripción)"
        qty = float(it.get("quantity") or 0)
        unit_price = float(it.get("unit_price") or 0)
        line_total = float(qty * unit_price)
        subtotal += line_total
        items.append(
            SalesDocumentItem(
                line_no=i,
                sku=(str(it.get("sku") or "").strip() or None),
                description=desc,
                unit_of_measure=(str(it.get("unit_of_measure") or "").strip() or None),
                quantity=qty,
                unit_price=unit_price,
                line_total=line_total,
            )
        )

    doc = SalesDocument(
        business_id=int(bid),
        location_id=int(loc_id),
        customer_id=customer.id,
        doc_type=doc_type_norm,
        year_month=year_month,
        seq=seq,
        code=code,
        issue_date=now,
        valid_until=valid_until_date,
        issuer_name=config.issuer.name,
        issuer_tax_id=config.issuer.tax_id or None,
        issuer_address=issuer_address,
        client_name=client_name,
        client_id=client_id,
        client_address=client_address,
        currency_symbol=selected_currency_symbol,
        currency_code=selected_currency_code,
        notes=notes,
        subtotal=subtotal,
        total=subtotal,
    )

    SalesDocumentService(db, bid).add_document(doc, items)
    db.commit()

    _clear_cart(request)
### REQ-4: Vencimiento en la vista previa y en la edición
**Priority:** Should Have

WHEN el usuario pide la vista previa de un `P`, THE SYSTEM SHALL mostrar "Vencimiento: dd/mm/aaaa" y SHALL llevar la
fecha al formulario "Emitir ahora". WHEN el usuario edita un `P` ya emitido, THE SYSTEM SHALL permitir cambiar
`valid_until` con la misma validación de REQ-3.

```gherkin
Scenario: La vista previa conserva el vencimiento
  GIVEN un P en vista previa con vencimiento "2026-12-31"
  WHEN el usuario pulsa "Emitir ahora"
  THEN el documento emitido tiene valid_until == 2026-12-31

Scenario: La vista previa de una factura no muestra vencimiento (negativo)
  WHEN el usuario pide la vista previa de una F
  THEN el texto "Vencimiento" NO aparece en la vista previa

Scenario: Editar el vencimiento de un presupuesto
  GIVEN un P emitido con valid_until 2026-12-03
  WHEN el usuario lo edita y pone "2026-12-20"
  THEN valid_until == 2026-12-20
  AND las líneas y el total NO cambian

Scenario: Editar un presupuesto antiguo sin fecha no le inventa una (negativo)
  GIVEN un P con valid_until NULL
  WHEN el usuario cambia solo las notas y deja vacío el vencimiento
  THEN valid_until sigue NULL

Scenario: Fecha no válida al editar no toca nada (negativo)
  GIVEN un P con cliente "A", 2 líneas y total 10
  WHEN el usuario envía vencimiento "31/12/2026", cambia el cliente a "B" y marca una línea para borrar
  THEN la respuesta es 422 HTML con "Fecha de vencimiento inválida"
  AND el documento guardado sigue con cliente "A", 2 líneas, total 10 y el valid_until anterior
```

