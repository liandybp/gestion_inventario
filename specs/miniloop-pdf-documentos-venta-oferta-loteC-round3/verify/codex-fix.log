+
+    response = sales_doc_preview(request=req, db=db_session, **_form(valid_until="31/12/2026"))
+
+    assert response.status_code == 422
+    assert ERROR in _body(response)
+    assert _get_draft(req)["valid_until"] == "31/12/2026"
