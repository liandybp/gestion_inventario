@@ content
def _parse_validity_days(value, fallback: int = 15) -> int:
    """Plazo de validez en días: entero acotado a 0-365. Un texto no numérico devuelve `fallback`."""
    try:
        days = int((value or "").strip())
    except ValueError:
        return fallback
    return max(0, min(365, days))


