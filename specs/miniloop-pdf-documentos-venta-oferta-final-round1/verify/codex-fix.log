+def default_valid_until(days: object) -> str:
+    """Vencimiento por defecto de un presupuesto: hoy (UTC) + `days` días, en `aaaa-mm-dd`."""
+    try:
+        offset = int(days or 0)
+    except (TypeError, ValueError):
+        offset = 0
