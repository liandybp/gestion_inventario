+    assert "FACTURA" in text
+    assert "No. Factura:" in text
+    assert "Fecha de factura:" in text
+    assert "FORMA DE PAGO" in text
+    assert "Recibido por:" in text
+    assert "Fecha de vencimiento" not in text
