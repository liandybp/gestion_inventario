    27	def _static_asset_version(static_dir: Path | None = None) -> str:
    28	    """Versión de cache-busting derivada del contenido de los assets estáticos.
    29	
    30	    Se comprueba en CADA render (no se congela en import): ``uvicorn --reload`` solo vigila ``*.py``, así que
    31	    editar un ``.css``/``.js`` no reinicia el proceso. El hash del contenido solo se recalcula cuando cambia la
    32	    firma (ruta, tamaño y mtime de cada fichero): antes se leían y hasheaban todos los assets en cada llamada.
    33	    """
    34	    root = static_dir or Path(__file__).resolve().parent.parent / "static"
    35	    now = time.monotonic()
    36	    last = _static_version_checked.get(str(root))
    37	    if last is not None and now - last[0] < _STATIC_VERSION_TTL_S:
    38	        return last[1]  # varias llamadas por render (y renders seguidos) no vuelven a tocar el disco
    39	    # Todos los .css/.js (también los módulos de js/core, js/components...): el hash cambia si cambia
    40	    # cualquiera, aunque main.js no cambie. La ruta entra en el hash (renombrar un módulo también invalida).
    41	    files = sorted(p for sub in ("css", "js") for p in (root / sub).rglob("*") if p.suffix in (".css", ".js"))
    42	    signature: list[tuple[str, int, int]] = []
    43	    for path in files:
    44	        try:
    45	            st = path.stat()
    46	        except OSError:
    47	            continue
    48	        signature.append((path.relative_to(root).as_posix(), st.st_size, st.st_mtime_ns))
    49	    key = (str(root), tuple(signature))
    50	    cached = _STATIC_VERSION_CACHE.get(key)
    51	    if cached is not None:
    52	        _static_version_checked[str(root)] = (now, cached)
    53	        return cached
    54	    digest = hashlib.sha1()
    55	    for path in files:
    56	        try:
    57	            digest.update(path.relative_to(root).as_posix().encode())
    58	            digest.update(path.read_bytes())
    59	        except OSError:
    60	            continue
    61	    version = digest.hexdigest()[:8]
    62	    _STATIC_VERSION_CACHE.clear()  # una sola entrada vigente por proceso
    63	    _STATIC_VERSION_CACHE[key] = version
    64	    _static_version_checked[str(root)] = (now, version)
    65	    return version
    66	
    67	
