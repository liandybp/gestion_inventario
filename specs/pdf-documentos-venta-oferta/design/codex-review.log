    10	export function init() {
    11	  document.addEventListener('htmx:beforeRequest', (evt) => {
    12	    const elt = evt.detail && evt.detail.elt;
    13	    if (!shouldPreserveScrollForElt(elt)) return;
    14	    pendingScrollRestore = window.scrollY;
    15	  });
    16	
    17	  // Los routers UI devuelven su panel con el mensaje de error y el status de la
    18	  // HTTPException (400/404/409/422...). htmx no swapea respuestas >= 400 por
    19	  // defecto, así que sin esto el error no se veía. Solo HTML: las 422 de
    20	  // validación de FastAPI son JSON y el 403 de CSRF es texto plano. El chat del
    21	  // copiloto ya inserta sus errores a mano.
    22	  document.addEventListener('htmx:beforeSwap', (evt) => {
    23	    const xhr = evt.detail && evt.detail.xhr;
    24	    if (!xhr || xhr.status < 400 || xhr.status >= 500) return;
    25	    const path = String((evt.detail.requestConfig && evt.detail.requestConfig.path) || '');
    26	    if (path.startsWith('/ui/agent/chat')) return;
    27	    const ct = String(xhr.getResponseHeader('Content-Type') || '');
    28	    if (!ct.includes('text/html')) return;
    29	    evt.detail.shouldSwap = true;
    30	    evt.detail.isError = false;
    31	  });
    32	
    33	  document.addEventListener('htmx:afterSwap', (evt) => {
    34	    const target = evt.target;
    35	    if (pendingScrollRestore !== null && target && (target.id === 'purchase-panel' || target.id === 'sale-panel')) {
    36	      const y = pendingScrollRestore;
    37	      pendingScrollRestore = null;
    38	      requestAnimationFrame(() => {
    39	        try { window.scrollTo({ top: y, left: 0, behavior: 'auto' }); } catch (e) { window.scrollTo(0, y); }
    40	      });
    41	    }
    42	  });
    43	}
