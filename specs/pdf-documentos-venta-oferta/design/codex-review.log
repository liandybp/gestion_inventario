   910	
   911	    now = datetime.now(timezone.utc)
   912	    year_month = now.strftime("%Y%m")
   913	    yyyymmdd = now.strftime("%Y%m%d")
   914	
   915	    max_seq = SalesDocumentService(db, bid).max_seq(year_month)
   916	    seq = int(max_seq or 0) + 1
   917	    code = f"{doc_type_norm}{yyyymmdd}{seq:04d}"
   918	
