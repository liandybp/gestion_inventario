   926	        config.issuer.country,
   927	    ]
   928	    issuer_address = ", ".join([p for p in issuer_address_parts if (p or "").strip()]) or None
   929	
   930	    items: list[SalesDocumentItem] = []
   931	    subtotal = 0.0
   932	    for i, it in enumerate(cart, start=1):
   933	        desc = str(it.get("description") or "").strip() or "(sin descripción)"
   934	        qty = float(it.get("quantity") or 0)
   935	        unit_price = float(it.get("unit_price") or 0)
   936	        line_total = float(qty * unit_price)
   937	        subtotal += line_total
   938	        items.append(
