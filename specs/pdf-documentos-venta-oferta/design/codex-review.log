   587	def _discover_business_codes_from_config_files() -> list[str]:
   588	    """
   589	    Descubre códigos de negocio escaneando app/business_config.*.conf.
   590	    Extrae el código del nombre del archivo: business_config.<code>.conf
   591	    Omite business_config.conf (el default, sin código).
   592	    """
   593	    import glob
   594	    from pathlib import Path
   595	
   596	    _app_dir = Path(__file__).resolve().parent
   597	    codes: list[str] = []
   598	    pattern = str(_app_dir / "business_config.*.conf")
   599	    for path in glob.glob(pattern):
   600	        name = os.path.basename(path)
   601	        # business_config.<code>.conf -> extraer <code>
   602	        if name == "business_config.conf":
   603	            continue
   604	        # quitar prefijo y sufijo
   605	        middle = name[len("business_config."):-len(".conf")]
   606	        if middle:
   607	            codes.append(middle)
   608	    return codes
