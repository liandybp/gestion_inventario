Uso: cc_design_check <repo> <slug>

Comprueba specs/<slug>/requirements.md y specs/<slug>/design.md y escribe por stdout una línea por problema
(`<código> <fichero>:<línea>: <mensaje>`). Termina con exit 1 si hay algún error (`D*`) o exit 0 si solo hay
avisos (`W*`) o nada.
"""
import re
import sys
from pathlib import Path

HEADER_RE = re.compile(r"^#{2,4}\s+(.*)$")
MODEL_RE = re.compile(r"\bModelo:\s*(\S.*)")
PIPE_RE = re.compile(r"(?<!\\)\|")
SEP_CELL_RE = re.compile(r":?-+:?")


def split_row(line: str) -> list[str]:
    """Celdas de una fila de tabla: quita el | inicial y final, parte por | NO escapado, strip."""
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    return [c.strip() for c in PIPE_RE.split(s)]


def table_after(lines: list[str], i: int) -> list[tuple[int, list[str]]]:
    """Primera tabla tras la línea i (0-based): [(nº de línea 1-based, celdas)], sin la fila separadora.

    Salta líneas en blanco o de texto antes de la tabla; para en la primera línea que no empiece por '|' tras
    empezar la tabla, o en un encabezado. [] si no hay tabla antes del siguiente encabezado.
    """
    rows: list[tuple[int, list[str]]] = []
    started = False
    j = i + 1
    while j < len(lines):
        line = lines[j]
        if HEADER_RE.match(line):
            break
        if line.strip().startswith("|"):
            started = True
            cells = split_row(line)
            if not all(SEP_CELL_RE.fullmatch(c) for c in cells):
                rows.append((j + 1, cells))
        elif started:
            break
        j += 1
    return rows


def check_model(name: str, lines: list[str]) -> tuple[list[str], list[str]]:
    """D2 si ninguna de las 15 primeras líneas casa con Modelo:; W1 si lo capturado no contiene 'opus'."""
    errors: list[str] = []
    warnings: list[str] = []
    model = ""
    for l in lines[:15]:
        m = MODEL_RE.search(l)
        if m:
            model = m.group(1).strip()
            break
    if not model:
        errors.append(f"D2 {name}:1: no hay línea 'Modelo: <texto>' en las 15 primeras líneas")
    elif "opus" not in model.lower():
        warnings.append(f"W1 {name}:1: el 'Modelo:' no contiene 'Opus'")
    return errors, warnings


def check_supuestos(repo: Path, lines: list[str]) -> list[str]:
    """D3, D4, D5, D6 sobre design.md (ver tabla de REQ-1)."""
    errors: list[str] = []
    sup_i = None
    for i, l in enumerate(lines):
        m = HEADER_RE.match(l)
        if m and "Supuestos" in m.group(1):
            sup_i = i
            break
    for l in lines:
        if re.match(r"^Supuestos:\s*ninguno\s*[—-]\s*\S", l):
            return errors
    if sup_i is None:
        errors.append("D3 design.md:1: falta la sección de Supuestos")
        return errors
    rows = table_after(lines, sup_i)
    if not rows:
        errors.append(f"D3 design.md:{sup_i + 1}: la sección de Supuestos no tiene tabla")
        return errors
    header = rows[0][1]

