+        pdf.multi_cell(width, ROW_H, _safe_pdf_text(client_address), align="L", new_x="LEFT", new_y="NEXT")
+    return pdf.get_y()
+
+
+def _draw_label_row(pdf: Any, y: float, label: str, value: str) -> float:
