+import io
+from datetime import date, datetime
+from typing import Any, Iterable, Optional
+
+from app.sales_documents_format import (
+    currency_column_label,
+    format_amount,
+    format_doc_date,
+    format_quantity,
+)
+
+MARGIN = 15.0
+CONTENT_W = 180.0
+RIGHT_X = 107.7
+RIGHT_W = 87.3
+LABEL_W = 40.0
+ROW_H = 4.9
+PAGE_BOTTOM = 282.0
+FOOTER_GAP = 8.0
+BLUE_LIGHT = (220, 230, 241)
+BLUE_DARK = (17, 90, 156)
