# =============================================================================
# Gestión de Inventario — Variables de entorno
# =============================================================================
# Copiar este archivo a .env y ajustar los valores.
# .env NO se commitea (está en .gitignore).

# Base de datos
# -----------------------------------------------------------------------------
# SQLite (dev local):
#   DATABASE_URL=sqlite+pysqlite:///./inventario.db
# PostgreSQL (producción):
#   DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/inventario
DATABASE_URL=sqlite+pysqlite:///./inventario.db

# Sesiones
# -----------------------------------------------------------------------------
# REQUERIDO en producción. Generar con:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=cambia-esto-por-un-secreto-de-64-caracteres-hex

# Solo habilitar en producción con HTTPS
SESSION_HTTPS_ONLY=0

# Credenciales iniciales (solo primer arranque)
# -----------------------------------------------------------------------------
# El seed solo corre si la BD está vacía (schema_version < 2).
# Cambiar después del primer deploy o desde la UI de usuarios.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=cambia-esto

# Configuración de negocio (opcional)
# -----------------------------------------------------------------------------
# Ruta al archivo de configuración por defecto
# BUSINESS_CONFIG_PATH=app/business_config.conf
# Directorio con configs por negocio
# BUSINESS_CONFIG_DIR=app/

# Logging
# -----------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING

# Uploads
# -----------------------------------------------------------------------------
# Tamaño máximo de imagen en MB
MAX_IMAGE_SIZE_MB=10

# Rate limiting (login)
# -----------------------------------------------------------------------------
# Máximo de intentos de login por IP en la ventana de tiempo
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
